# --- Server-side only (used by Vercel serverless function api/debrief.js) ---
# Never prefix these with VITE_ — that would inline them into the browser bundle.
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Optional: override the model slug (default: anthropic/claude-sonnet-4)
OPENROUTER_MODEL=
# Optional: attribution shown in the OpenRouter dashboard
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Pitch Presence Coach

# --- Client-safe (exposed in the browser bundle; Supabase Row Level Security is the boundary) ---
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# --- Server-side only (used by scripts/seedQuestionBank.mjs to write the question bank) ---
# The service role key bypasses RLS — keep it secret, never expose or prefix with VITE_.
# SUPABASE_URL falls back to VITE_SUPABASE_URL if unset.
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Deprecated: the Anthropic key is no longer used by the client. The model call now
# runs server-side via OpenRouter (see OPENROUTER_API_KEY above). Safe to remove.
# VITE_ANTHROPIC_API_KEY=
